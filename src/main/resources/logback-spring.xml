<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그 포맷에 traceId / spanId 주입.
  Spring Boot Micrometer Tracing이 OTel 컨텍스트와 연동되어 MDC에
    traceId, spanId
  키를 자동으로 채움. 패턴에서 %X{traceId:-} 로 꺼내 출력.

  채팅 trace는 publisher → Redis pub/sub → subscriber → STOMP send 까지 이어지므로
  로그 traceId로 한 메시지의 전체 흐름을 추적 가능.

  로그 예시:
    2026-05-04 10:00:00.123 INFO  [4bf92f3577b34da6a3ce929d0e0e4736,00f067aa0ba902b7] c.h.f.controller.ChatController - 메시지 수신
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{trace_id:-},%X{span_id:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 라이브러리 별 로그 레벨 -->
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.messaging" level="INFO"/>
    <logger name="com.hsp.fituchat" level="INFO"/>
</configuration>